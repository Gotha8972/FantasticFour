# Copy to .env (git-ignored) and fill in. Never commit .env.
NVIDIA_API_KEY=nvapi-...
# Optional: another NVIDIA-hosted chat model (default: openai/gpt-oss-20b) and any extra request fields it needs
# NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NIM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# gpt-oss runs at low reasoning effort by default (dry run 45 s; docs/team/LOW_REASONING_RUN.md).
# To use the model's default effort instead:
# NIM_EXTRA_BODY={}
