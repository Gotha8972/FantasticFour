    {
      "id": 6,
      "title": "Checkout success (2 min)",
      "description": "Successful fraction of checkout requests over two minutes. No data when no checkout requests completed.",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - sum(rate(boutique_locust_checkout_failures_total[2m])) / sum(rate(boutique_locust_checkout_requests_total[2m]))",
