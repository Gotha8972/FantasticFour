      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(boutique_locust_stats_available)",
          "legendFormat": "Locust CSV freshness",
          "range": true,
          "instant": false
