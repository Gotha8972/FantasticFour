{
  "uid": "boutique-chaos",
  "title": "Online Boutique \u2014 Chaos Overview",
  "tags": [
    "online-boutique",
    "chaos",
    "locust"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Start here: connect traffic, faults, and customer impact",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**1. Confirm telemetry is fresh and shoppers are active. 2. Watch confirmed chaos injection turn on. 3. Compare errors, latency, checkout success, and pod/resource charts.**\n\nA fault being removed does not mean pods have recovered. No data means missing measurements, not zero failures. Latency is the recent aggregate estimate from Locust; the CPU and memory panels show individual pods. Monitoring begins after installation and does not import older runs."
      }
    },
    {
      "id": 2,
      "title": "Active shoppers",
      "description": "Concurrent Locust users; these are not requests per second.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(boutique_locust_users)",
          "legendFormat": "Active shoppers",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
