{
  "name": "chaos-sandbox",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "none" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" }
  },
  "forwardPorts": [8080, 3000, 9090, 2333],
  "portsAttributes": {
    "8080": { "label": "Online Boutique" },
    "3000": { "label": "Grafana" },
    "9090": { "label": "Prometheus" },
    "2333": { "label": "Chaos Mesh" }
  }
}
